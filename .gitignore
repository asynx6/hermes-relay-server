# Local agent workspace (memory log, not part of the repo)
.workbuddy-ai/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets and local environment
.env
*.local

# Runtime data (DB, filemanager, downloads) — folders are tracked via .gitkeep
*.db
*.db-wal
*.db-shm
data/dashboard_auth.json
data/dashboard_jwt_secret
filemanager/*
!filemanager/.gitkeep
downloads/*
!downloads/.gitkeep

# Test and tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Packaging artifacts (regenerated, never committed)
*.zip

# Runtime logs and local test output
*.log

# Editor and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
