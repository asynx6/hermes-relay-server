REGISTRATION_KEY=ganti-dengan-string-acak-panjang
DB_PATH=data/relay.db
FILEMANAGER_DIR=filemanager
MAX_UPLOAD_MB=25
BLOCKED_EXT=.exe,.bat,.cmd,.msi,.dll,.scr,.ps1
RETENTION_DAYS=30
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute

# Validasi unggahan
# Kuota total penyimpanan per agent (0 = tanpa kuota).
MAX_STORAGE_MB_PER_AGENT=0
# True = tolak kalau ekstensi dan isi file tidak cocok (magic bytes).
STRICT_MIME_MATCH=false

# Unggahan berpotong (chunked) & resumable
# Ukuran maksimal satu chunk yang dikirim client.
CHUNK_MB=5
# Sesi unggah yang ditinggalkan disapu setelah sekian jam (lihat scripts/cleanup.py).
CHUNK_SESSION_HOURS=24
# Batas total satu unggahan berpotong.
MAX_CHUNKED_MB=512

# Keamanan token
# Kunci lama tetap diterima sekian menit setelah POST /rotate-token.
TOKEN_GRACE_MINUTES=5
# Baris audit_log lebih tua dari ini dipangkas oleh scripts/cleanup.py.
AUDIT_LOG_RETENTION_DAYS=90

# Latensi: long polling & SSE (polling biasa tetap jadi fallback)
# GET /fetch-messages?wait=N menahan request sampai ada pesan/timeout.
LONG_POLL_ENABLED=true
LONG_POLL_MAX_SECONDS=25
# GET /events (Server-Sent Events). Butuh proxy tanpa buffering respons.
SSE_ENABLED=true
SSE_HEARTBEAT_SECONDS=15

# Dashboard admin (http://host:8000/dashboard)
# Password awal '123456'; disimpan sebagai PBKDF2 di data/dashboard_auth.json.
# DASHBOARD_PASSWORD hanya berlaku saat instalasi pertama (file auth belum ada).
DASHBOARD_PASSWORD=123456
SESSION_HOURS=24
COOKIE_SECURE=false
