REGISTRATION_KEY=replace-with-a-long-random-string
DB_PATH=data/relay.db
FILEMANAGER_DIR=filemanager
MAX_UPLOAD_MB=25
BLOCKED_EXT=.exe,.bat,.cmd,.msi,.dll,.scr,.ps1
RETENTION_DAYS=30
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute

# Upload validation
# Total storage quota per agent (0 = no quota).
MAX_STORAGE_MB_PER_AGENT=0
# True = reject when the extension and the file content disagree (magic bytes).
STRICT_MIME_MATCH=false

# Chunked and resumable uploads
# Maximum size of a single chunk sent by the client.
CHUNK_MB=5
# Abandoned upload sessions are swept after this many hours (see scripts/cleanup.py).
CHUNK_SESSION_HOURS=24
# Total size limit for one chunked upload.
MAX_CHUNKED_MB=512

# Token security
# The previous key stays valid for this many minutes after POST /rotate-token.
TOKEN_GRACE_MINUTES=5
# audit_log rows older than this are pruned by scripts/cleanup.py.
AUDIT_LOG_RETENTION_DAYS=90

# Latency: long polling and SSE (plain polling remains the fallback)
# GET /fetch-messages?wait=N holds the request until a message arrives or it times out.
LONG_POLL_ENABLED=true
LONG_POLL_MAX_SECONDS=25
# GET /events (Server-Sent Events). Requires a proxy that does not buffer responses.
SSE_ENABLED=true
SSE_HEARTBEAT_SECONDS=15

# Admin dashboard (http://host:8000/dashboard)
# Initial password '123456'; stored as PBKDF2 in data/dashboard_auth.json.
# DASHBOARD_PASSWORD only applies to the first install (before the auth file exists).
DASHBOARD_PASSWORD=123456
SESSION_HOURS=24
COOKIE_SECURE=false
