# Hermes Agent tidak membaca .env. Konfigurasi ada di config.json.
# File ini hanya contoh variabel yang setara, kalau kamu ingin memindahkan
# konfigurasi ke environment melalui wrapper sendiri.

HERMES_SERVER_URL=http://127.0.0.1:8000/api/v1
HERMES_REGISTRATION_KEY=isi-registration-key-dari-server
HERMES_AGENT_NAME=hermes-alpha
HERMES_POLL_MIN_SECONDS=3
HERMES_POLL_MAX_SECONDS=30
HERMES_DOWNLOAD_DIR=downloads
HERMES_MAX_UPLOAD_MB=25
